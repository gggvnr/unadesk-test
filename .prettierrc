{
  "printWidth": 100,
  "singleQuote": true,
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "angular",
        "printWidth": 80,
        "singleAttributePerLine": true
      }
    }
  ],
  "plugins": [
    "prettier-plugin-css-order",
    "prettier-plugin-organize-imports"
  ]
}
